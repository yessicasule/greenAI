# Where the FastAPI backend (backend/src/green_weight/api.py) is listening.
# Used by vite.config.js to proxy the dashboard's /api/* calls in `npm run
# dev` and `npm run preview`. Defaults to http://localhost:8000.
VITE_BACKEND_URL=http://localhost:8000

# Optional: bypass the proxy entirely and have the browser call the backend
# directly. Only needed when serving a built bundle from something other
# than `vite preview` (a static host, another machine). The backend's CORS
# allow-list in api.py must then include the dashboard's origin.
# VITE_API_BASE=http://localhost:8000
